{
  "expo": {
    "name": "Daily Accounts",
    "slug": "DailyAccounts",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#121212"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.dailyaccounts.dailyaccounts"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "@howincodes/expo-dynamic-app-icon",
        {
          "red": {
            "ios": "./assets/icon-red.png",
            "android": {
              "foregroundImage": "./assets/adaptive-icon-red.png",
              "backgroundColor": "#1E1E1E"
            }
          },
          "green": {
            "ios": "./assets/icon-green.png",
            "android": {
              "foregroundImage": "./assets/adaptive-icon-green.png",
              "backgroundColor": "#1E1E1E"
            }
          },
          "purple": {
            "ios": "./assets/icon-purple.png",
            "android": {
              "foregroundImage": "./assets/adaptive-icon-purple.png",
              "backgroundColor": "#1E1E1E"
            }
          },
          "orange": {
            "ios": "./assets/icon-orange.png",
            "android": {
              "foregroundImage": "./assets/adaptive-icon-orange.png",
              "backgroundColor": "#1E1E1E"
            }
          }
        }
      ]
    ]
  }
}
